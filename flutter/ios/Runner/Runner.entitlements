<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<!-- Keychain access group for flutter_secure_storage (Keychain-backed). -->
	<!-- App Attest: the hardware-backed proof the attestation ledger accepts
	     as evidence that a pubkey belongs to a real Nymchat install. The App
	     ID must have the App Attest capability and the provisioning profile
	     must include it, or attestKey fails at runtime and the app simply
	     enrolls nothing. `production` on a store build; switch to
	     `development` alongside APPLE_APP_ATTEST_ALLOW_DEVELOPMENT=1 on the
	     worker to test against Apple's development environment. -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.nym.bar</string>
		<string>$(AppIdentifierPrefix)com.nym.shared</string>
	</array>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:web.nymchat.app</string>
		<string>webcredentials:web.nymchat.app</string>
	</array>
</dict>
</plist>
