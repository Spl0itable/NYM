# Uncomment this line to define a global platform for your project
platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

# App Store review rejects any reference to `RPSystemBroadcastPickerView`'s
# private `buttonPressed:` selector, which flutter_webrtc uses to open the
# broadcast picker programmatically (ios/Classes/FlutterRTCDesktopCapturer.m).
#
# The block only runs when a caller asks for the broadcast extension, and
# Nymchat never does — `_startScreenShare` requests plain
# `getDisplayMedia({video:true})`, which takes the in-app ReplayKit path. So
# removing it costs us nothing, while leaving it in costs us the submission:
# the scan looks for the symbol in the binary, not for a reachable call.
#
# Idempotent, and re-applied on every `pod install` because `flutter pub get`
# restores the pristine plugin source.
def strip_private_broadcast_picker(installer)
  root = File.realpath(File.join(__dir__, '.symlinks', 'plugins', 'flutter_webrtc'))
  target = File.join(root, 'ios', 'Classes', 'FlutterRTCDesktopCapturer.m')
  return unless File.exist?(target)

  src = File.read(target)
  return if src.include?('NYM_PRIVATE_PICKER_STRIPPED')

  needle = <<~OBJC
    SEL selector = NSSelectorFromString(@"buttonPressed:");
    if ([picker respondsToSelector:selector]) {
      [picker performSelector:selector withObject:nil];
    }
  OBJC
  replacement = <<~OBJC
    // NYM_PRIVATE_PICKER_STRIPPED — see ios/Podfile. `buttonPressed:` is
    // private API and fails App Store review; the picker is left for the
    // user to present. Unreachable here: Nymchat never requests the
    // broadcast extension.
  OBJC

  # Match the block regardless of leading indentation.
  pattern = /^[ \t]*SEL selector = NSSelectorFromString\(@"buttonPressed:"\);\n[ \t]*if \(\[picker respondsToSelector:selector\]\) \{\n[ \t]*\[picker performSelector:selector withObject:nil\];\n[ \t]*\}\n/
  unless src =~ pattern
    raise "flutter_webrtc: could not find the buttonPressed: block to strip. " \
          "Check whether the plugin fixed it upstream, then drop this patch."
  end

  File.write(target, src.sub(pattern, replacement))
  Pod::UI.puts '[nym] stripped private buttonPressed: from flutter_webrtc'.green
end

post_install do |installer|
  strip_private_broadcast_picker(installer)

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Ensure every pod builds against our iOS floor to satisfy plugin minimums.
      # CocoaPods resolves specs based on this value; keeping it consistent prevents
      # "required a higher minimum deployment target" failures.
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 17.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
      end
      
      # Enable permission_handler permissions for iOS
      # Without these, permission requests won't trigger the system dialog
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_LOCATION=1',
      ]
    end
  end
end
